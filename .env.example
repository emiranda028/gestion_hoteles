# Copiar como .env en el servidor y completar. NUNCA subir el .env a GitHub.

# Carpeta donde viven los datos reales (fuera del código, para que no se pisen al actualizar)
DATA_DIR=/home/USUARIO/gestion_hoteles_datos

# Sesiones: una cadena larga y aleatoria (por ej.: openssl rand -hex 32)
SESSION_SECRET=

# Administrador inicial: se crea la primera vez que alguien ingresa. Después se gestionan desde /admin/usuarios
ADMIN_USUARIO=admin@ltelc
ADMIN_PASSWORD=

# Gmail donde llegan los reportes (contraseña de APLICACIÓN de Google, no la clave normal)
GMAIL_USER=agencialtelc@gmail.com
GMAIL_APP_PASSWORD=

# (opcional) Planilla de huéspedes por país compartida en Drive
PAISES_URL=

PORT=3000
NODE_ENV=production
